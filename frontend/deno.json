{
  "tasks": {
    "dev": "vite",
    "build": "vite build",
    "start": "deno serve -A _fresh/server.js",
    "test": "deno test",
    "check": "deno fmt --check . && deno lint . && deno check --unstable-sloppy-imports"
  },
  "lint": {
    "exclude": ["src/module_bindings"],
    "rules": {
      "tags": ["fresh", "recommended"]
    }
  },
  "fmt": {
    "exclude": ["src/module_bindings"]
  },
  "exclude": ["**/_fresh/*"],
  "imports": {
    "@/": "./",
    "@fresh/plugin-vite": "jsr:@fresh/plugin-vite@^1.1.2",
    "@preact/signals": "npm:@preact/signals@^2.9.0",
    "@types/babel__core": "npm:@types/babel__core@^7.20.5",
    "fresh": "jsr:@fresh/core@^2.3.3",
    "preact": "npm:preact@^10.29.1",
    "spacetimedb": "npm:spacetimedb@2.8.*",
    "vite": "npm:vite@^7.1.3"
  },
  "compilerOptions": {
    "lib": ["dom", "dom.asynciterable", "dom.iterable", "deno.ns"],
    "jsx": "precompile",
    "jsxImportSource": "preact",
    "jsxPrecompileSkipElements": [
      "a",
      "body",
      "head",
      "html",
      "img",
      "link",
      "meta",
      "noscript",
      "script",
      "source",
      "style",
      "template",
      "title"
    ],
    "types": ["vite/client"]
  }
}
